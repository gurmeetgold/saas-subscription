<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{20} — %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Our code at INFO — you see every step clearly -->
  <logger name="io.temporal.subscription" level="INFO"/>

  <!-- Temporal SDK internals at WARN — keeps the demo output clean -->
  <logger name="io.temporal"  level="WARN"/>
  <logger name="io.grpc"      level="WARN"/>
  <logger name="com.uber"     level="WARN"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
